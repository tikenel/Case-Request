# Client (baked in at build time)
VITE_SMART_CLIENT_ID=            # from fhir.epic.com > Build Apps (non-production or production client id)
VITE_SMART_SCOPES=launch openid fhirUser patient/Patient.read patient/Condition.read patient/MedicationRequest.read patient/AllergyIntolerance.read patient/Observation.read patient/Coverage.read patient/DocumentReference.read patient/Binary.read patient/Encounter.read patient/Appointment.read patient/ServiceRequest.read user/Practitioner.read user/Patient.read user/Appointment.read user/ServiceRequest.read user/List.read
VITE_WRITE_NOTE=0                # 1 = offer "File note in Epic" (needs DocumentReference.Create)
VITE_NOTE_TYPE_SYSTEM=http://loinc.org
VITE_NOTE_TYPE_CODE=11506-3
VITE_NOTE_TYPE_DISPLAY=Progress note
VITE_WRITE_ORDERS=0
VITE_TRACKING_LIST=               # Epic patient list for the My cases board, system|id (from your Epic team)
VITE_CASE_REQUEST_CATEGORY=       # optional: Epic order category for case requests, system|code              # 1 = offer "Send as orders" (needs ServiceRequest.Create)

# Server
FHIR_ISS_ALLOWLIST=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
ANTHROPIC_API_KEY=               # only under a BAA covering PHI; leave empty to run without AI
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
ALLOW_DEMO=1                     # 0 in production
PORT=8787
